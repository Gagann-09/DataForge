# Server Environment Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=dataforge
COLLECTION_NAME=events
SEED_COUNT=150000

# Network & CORS Security
# Comma-separated list of allowed origins. Defaults to localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Proxy Configuration
# WARNING: Setting TRUST_PROXY=true trusts ALL upstream hops indiscriminately,
# making client IP detection and rate limiting vulnerable to header spoofing (X-Forwarded-For).
# For production environments behind a reverse proxy (e.g., Nginx, AWS ALB, Cloudflare),
# configure a trusted CIDR subnet (e.g., '10.0.0.0/8', 'loopback') or a validated
# integer hop count (e.g., '1') instead of 'true'.
# Supported values: 'false' (default), 'true', hop count integer (e.g. '1'),
# or trusted subnet/CIDR/IP (e.g., 'loopback', 'linklocal', 'uniquelocal', '10.0.0.0/8').
TRUST_PROXY=false

# In-Memory Rate Limiting (Single-instance burst mitigation)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Simulation (Milestone M4) - Opt-in only
# SIMULATE=false
# SIMULATE_DURATION=60
